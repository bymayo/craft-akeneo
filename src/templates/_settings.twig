{% import '_includes/forms.twig' as forms %}

<div id="akeneo-settings-tabs" class="pane-tabs">
    <nav>
        <ul>
            <li><a id="tab-api-btn" class="tab sel" href="#tab-api" data-tab="tab-api">API</a></li>
            <li><a id="tab-sync-btn" class="tab" href="#tab-sync" data-tab="tab-sync">Sync</a></li>
        </ul>
    </nav>
</div>

<div id="tab-api">
    {{ forms.autosuggestField({
        first: true,
        label: 'API URL',
        instructions: 'The base URL of your Akeneo PIM instance.',
        id: 'apiUrl',
        name: 'apiUrl',
        value: settings.apiUrl,
        suggestEnvVars: true,
        required: true,
        errors: settings.getErrors('apiUrl'),
    }) }}

    {{ forms.autosuggestField({
        label: 'Client ID',
        instructions: 'The Akeneo API client ID.',
        id: 'clientId',
        name: 'clientId',
        value: settings.clientId,
        suggestEnvVars: true,
        required: true,
        errors: settings.getErrors('clientId'),
    }) }}

    {{ forms.autosuggestField({
        label: 'Secret Key',
        instructions: 'The Akeneo API secret key.',
        id: 'secretKey',
        name: 'secretKey',
        value: settings.secretKey,
        suggestEnvVars: true,
        required: true,
        errors: settings.getErrors('secretKey'),
    }) }}

    {{ forms.autosuggestField({
        label: 'Username',
        instructions: 'The Akeneo API username.',
        id: 'username',
        name: 'username',
        value: settings.username,
        suggestEnvVars: true,
        required: true,
        errors: settings.getErrors('username'),
    }) }}

    {{ forms.autosuggestField({
        label: 'Password',
        instructions: 'The Akeneo API password.',
        id: 'password',
        name: 'password',
        value: settings.password,
        suggestEnvVars: true,
        required: true,
        errors: settings.getErrors('password'),
    }) }}

    {{ forms.textField({
        label: 'Attribute Cache Duration',
        instructions: 'How long (in seconds) to cache Akeneo attributes. Set to 0 to disable caching.',
        id: 'attributeCacheDuration',
        name: 'attributeCacheDuration',
        value: settings.attributeCacheDuration,
        type: 'number',
        min: 0,
        size: 10,
        errors: settings.getErrors('attributeCacheDuration'),
    }) }}

    <hr>

    <div class="field">
        <div class="heading">
            <label>Connection Status</label>
            <div class="instructions"><p>Test the connection to your Akeneo PIM instance using the saved credentials.</p></div>
        </div>
        <div class="input">
            <button type="button" class="btn" onclick="window._testAkeneoConnection(this)">Test Connection</button>
            <div class="akeneo-connection-result" style="display: none; margin-top: 10px; padding: 10px 14px; border-radius: 4px;"></div>
        </div>
    </div>
</div>

<div id="tab-sync" class="hidden">
    {{ forms.textField({
        first: true,
        label: 'Sync Page Size',
        instructions: 'Number of products to fetch per API request during sync.',
        id: 'syncPageSize',
        name: 'syncPageSize',
        value: settings.syncPageSize,
        type: 'number',
        min: 1,
        max: 100,
        size: 10,
        errors: settings.getErrors('syncPageSize'),
    }) }}

    {{ forms.textField({
        label: 'Sync Max Pages',
        instructions: 'Maximum number of pages to fetch during a sync. Controls how many products are synced in total (page size x max pages).',
        id: 'syncMaxPages',
        name: 'syncMaxPages',
        value: settings.syncMaxPages,
        type: 'number',
        min: 1,
        size: 10,
        errors: settings.getErrors('syncMaxPages'),
    }) }}

    {% set volumeOptions = [] %}
    {% for volume in craft.app.volumes.getAllVolumes() %}
        {% set volumeOptions = volumeOptions|merge([{ label: volume.name, value: volume.handle }]) %}
    {% endfor %}

    {{ forms.selectField({
        label: 'Asset Volume',
        instructions: 'The Craft asset volume to store Akeneo images in.',
        id: 'assetVolumeHandle',
        name: 'assetVolumeHandle',
        value: settings.assetVolumeHandle,
        options: volumeOptions,
        required: true,
        errors: settings.getErrors('assetVolumeHandle'),
    }) }}

    {{ forms.textField({
        label: 'Asset Folder Name',
        instructions: 'The folder name within the volume where Akeneo images are stored.',
        id: 'assetFolderName',
        name: 'assetFolderName',
        value: settings.assetFolderName,
        required: true,
        errors: settings.getErrors('assetFolderName'),
    }) }}
</div>

<script type="text/javascript">
(function() {
    var tabs = document.querySelectorAll('#akeneo-settings-tabs a.tab');
    var panels = {
        'tab-api': document.getElementById('tab-api'),
        'tab-sync': document.getElementById('tab-sync')
    };

    tabs.forEach(function(tab) {
        tab.addEventListener('click', function(e) {
            e.preventDefault();
            var target = this.getAttribute('data-tab');

            tabs.forEach(function(t) { t.classList.remove('sel'); });
            this.classList.add('sel');

            Object.keys(panels).forEach(function(key) {
                panels[key].classList.toggle('hidden', key !== target);
            });
        });
    });
})();

window._testAkeneoConnection = function(btn) {
    var result = btn.nextElementSibling;
    btn.classList.add('loading');
    btn.disabled = true;
    result.style.display = 'none';
    result.textContent = '';

    var url = Craft.actionUrl + '/akeneo/sync/test-connection';
    var body = new FormData();
    body.append(Craft.csrfTokenName, Craft.csrfTokenValue);

    fetch(url, {
        method: 'POST',
        headers: {'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
        body: body
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        btn.classList.remove('loading');
        btn.disabled = false;
        result.style.display = 'block';

        if (data && data.success) {
            result.textContent = data.message;
            result.style.background = '#E8F5E9';
            result.style.color = '#2E7D32';
        } else {
            result.textContent = (data && data.message) ? data.message : 'Connection failed.';
            result.style.background = '#FDECEA';
            result.style.color = '#C62828';
        }
    })
    .catch(function() {
        btn.classList.remove('loading');
        btn.disabled = false;
        result.style.display = 'block';
        result.textContent = 'Connection failed.';
        result.style.background = '#FDECEA';
        result.style.color = '#C62828';
    });
};

var _btn = document.querySelector('[onclick*="_testAkeneoConnection"]');
if (_btn) {
    window._testAkeneoConnection(_btn);
}
</script>
