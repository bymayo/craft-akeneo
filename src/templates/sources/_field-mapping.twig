{% extends '_layouts/cp' %}

{% import '_includes/forms.twig' as forms %}

{% set fullPageForm = true %}

{% set title = title %}
{% set selectedSubnavItem = 'sources' %}

{% set crumbs = [
    { label: 'Akeneo', url: url('akeneo') },
    { label: 'Sources', url: url('akeneo/sources') },
    { label: source.name, url: url('akeneo/sources/' ~ source.id) },
] %}

{% set tabs = {
    settings: { label: 'Settings', url: url('akeneo/sources/' ~ source.id) },
    fieldMapping: { label: 'Field Mapping', url: url('akeneo/sources/' ~ source.id ~ '/field-mapping') },
    consoleCommands: { label: 'Console Commands', url: url('akeneo/sources/' ~ source.id ~ '/console-commands') },
    log: { label: 'Log', url: url('akeneo/sources/' ~ source.id ~ '/log') },
} %}
{% set selectedTab = 'fieldMapping' %}

{% block actionButton %}
    {% include 'akeneo/sources/_sync-button' %}
    {% include 'akeneo/sources/_save-button' with {
        continueEditingUrl: 'akeneo/sources/' ~ source.id ~ '/field-mapping',
    } %}
{% endblock %}

{% block content %}

    <input type="hidden" name="action" value="akeneo/sources/save-field-mapping">
    {{ redirectInput('akeneo/sources') }}
    <input type="hidden" name="sourceId" value="{{ source.id }}">

    {% css %}
        .table-mapping-row table.data thead th,
        .matrix-entry-row table.data thead th {
            background-color: var(--gray-100) !important;
            color: var(--gray-700);
        }
        .table-mapping-row table.data tbody tr:hover td,
        .matrix-entry-row table.data tbody tr:hover td {
            background-color: transparent !important;
        }
        .akeneo-section-heading td,
        .akeneo-section-heading:hover td {
            border-top: 1px solid var(--gray-200) !important;
            padding-top: 8px !important;
            padding-bottom: 0 !important;
            background-color: transparent !important;
        }
        .akeneo-section-heading td strong {
            font-size: 16px;
        }
        .akeneo-mapping-table,
        .table-mapping-row table.data,
        .matrix-entry-row table.data {
            table-layout: fixed;
        }
        .akeneo-mapping-table > thead > tr > th:nth-child(1),
        .akeneo-mapping-table > tbody > tr > td:nth-child(1) {
            width: 22%;
        }
        .akeneo-mapping-table > thead > tr > th:nth-child(2) {
            width: 13%;
        }
        .akeneo-mapping-table > thead > tr > th:nth-child(3) {
            width: 32%;
        }
        .akeneo-mapping-table > thead > tr > th:nth-child(4) {
            width: 33%;
        }
        .table-mapping-row table.data thead th:nth-child(1),
        .matrix-entry-row table.data thead th:nth-child(1) {
            width: 24%;
        }
        .table-mapping-row table.data thead th:nth-child(2),
        .table-mapping-row table.data thead th:nth-child(3),
        .matrix-entry-row table.data thead th:nth-child(2),
        .matrix-entry-row table.data thead th:nth-child(3) {
            width: 38%;
        }
        /* Craft sets .selectize.select:not(.fullwidth) to a fixed width: 25cm,
           which makes the single dropdowns narrower than the cell. Override it
           so they fill their column like the multiselects do. */
        .akeneo-mapping-table td .selectize.select,
        .table-mapping-row td .selectize.select,
        .matrix-entry-row td .selectize.select {
            width: 100% !important;
            max-width: 100% !important;
        }
        .akeneo-mapping-table td .selectize-control,
        .table-mapping-row td .selectize-control,
        .matrix-entry-row td .selectize-control {
            width: 100%;
            max-width: none;
            min-width: 0;
        }
        .akeneo-mapping-table .selectize-control .selectize-input,
        .table-mapping-row .selectize-control .selectize-input,
        .matrix-entry-row .selectize-control .selectize-input {
            width: 100%;
            box-sizing: border-box;
        }
        .akeneo-mapping-table td .text,
        .table-mapping-row td .text,
        .matrix-entry-row td .text,
        .akeneo-mapping-table td select,
        .table-mapping-row td select,
        .matrix-entry-row td select {
            width: 100%;
            box-sizing: border-box;
        }
        .table-mapping-row > .delete.icon,
        .matrix-entry-row > .delete.icon {
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            background-color: var(--white);
            border: 1px solid var(--gray-200);
            border-radius: var(--small-border-radius, 4px);
        }
    {% endcss %}

    {% if akeneoError %}
        <div class="readable" style="margin-bottom: 24px;">
            <blockquote class="note warning">
                <p><strong>Could not connect to Akeneo API:</strong> {{ akeneoError }}</p>
                <p>Akeneo attribute options will not be available until the connection is restored.</p>
            </blockquote>
        </div>
    {% endif %}

    {# Build selectize options array with optgroups #}
    {% set akeneoSelectOptions = [
        { value: '__none__', label: "Don't import" },
        { value: '__static__', label: 'Static Value' },
    ] %}
    {% set lastType = null %}
    {% for attribute in akeneoAttributes %}
        {% if (attribute.type ?? '') != lastType %}
            {% set lastType = attribute.type ?? '' %}
            {% set akeneoSelectOptions = akeneoSelectOptions|merge([{ optgroup: lastType ?: 'Other' }]) %}
        {% endif %}
        {% set akeneoSelectOptions = akeneoSelectOptions|merge([{ value: attribute.code, label: attribute.label }]) %}
    {% endfor %}

    {# Build asset-only selectize options (pim_catalog_asset_collection only) #}
    {% set akeneoAssetSelectOptions = [
        { value: '__none__', label: "Don't import" },
    ] %}
    {% for attribute in akeneoAttributes %}
        {% if (attribute.type ?? '') == 'pim_catalog_asset_collection' %}
            {% set akeneoAssetSelectOptions = akeneoAssetSelectOptions|merge([{ value: attribute.code, label: attribute.label }]) %}
        {% endif %}
    {% endfor %}

    {# Build lookup of existing mappings by handle #}
    {% set mappingsByHandle = {} %}
    {% for mapping in mappings %}
        {% set mappingsByHandle = mappingsByHandle|merge({ (mapping.craftFieldHandle): mapping.akeneoAttribute }) %}
    {% endfor %}

    <table class="data fullwidth akeneo-mapping-table">
        <thead>
            <tr>
                <th>Field</th>
                <th>Fieldtype</th>
                <th>Akeneo Attribute</th>
                <th>Static Value</th>
            </tr>
        </thead>
        <tbody>
            {% for field in craftFields %}
                {% set idx = loop.index0 %}
                {% set currentValue = mappingsByHandle[field.handle] ?? '' %}

                {% set prevTab = idx > 0 ? (craftFields[idx - 1].tab ?? null) : null %}
                {% set groupChanged = idx > 0 and (field.group ?? 'custom') != (craftFields[idx - 1].group ?? 'custom') %}
                {% set tabChanged = (field.tab ?? null) and field.tab != prevTab %}

                {% if groupChanged and (field.group ?? '') == 'variant' %}
                    <tr class="akeneo-section-heading"><td colspan="4"><strong>Variant</strong></td></tr>
                {% elseif tabChanged %}
                    <tr class="akeneo-section-heading"><td colspan="4"></td></tr>
                {% endif %}

                {% if field.type == 'table' %}
                    {# Decode existing table rows from JSON #}
                    {% set tableRows = currentValue ? currentValue|json_decode : [] %}

                    <tr>
                        <td style="vertical-align: top;">
                            <strong>{{ field.name }}</strong>{% if field.required ?? false %}<span class="required"></span>{% endif %}<br>
                            <code style="font-size: 10px;">{{ field.handle }}</code>
                            <input type="hidden" name="mappings[{{ idx }}][craftFieldHandle]" value="{{ field.handle }}">
                        </td>
                        <td style="vertical-align: top;">
                            <span class="light">{{ field.fieldType }}</span>
                        </td>
                        <td colspan="2">
                            <div class="table-field-mapping" data-field-index="{{ idx }}">
                                <div class="table-rows-body">
                                    {% for row in tableRows %}
                                        <div class="table-mapping-row" style="border: 1px solid var(--gray-200); border-radius: 4px; padding: 12px; margin-bottom: 8px; position: relative;">
                                            <a class="delete icon table-row-delete" title="Remove" style="position: absolute; top: 6px; right: 6px;"></a>
                                            <table class="data fullwidth">
                                                <thead>
                                                    <tr>
                                                        <th>Column</th>
                                                        <th>Akeneo Attribute</th>
                                                        <th>Static Value</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for colId, col in field.columns %}
                                                        {% set colAkeneo = row[colId].akeneo ?? '' %}
                                                        {% set colStatic = row[colId].static ?? '' %}
                                                        {% set colValue = colAkeneo == '__static__' or (colStatic and not colAkeneo) ? '__static__' : (colAkeneo ?: '__none__') %}
                                                        <tr>
                                                            <td style="vertical-align: middle; white-space: nowrap;">
                                                                <strong>{{ col.heading }}</strong><br><code style="font-size: 10px;">{{ col.handle }}</code>
                                                            </td>
                                                            <td>
                                                                {{ forms.selectize({
                                                                    name: 'mappings[' ~ idx ~ '][tableRows][' ~ loop.parent.loop.index0 ~ '][' ~ colId ~ '][akeneo]',
                                                                    value: colValue,
                                                                    options: akeneoSelectOptions,
                                                                }) }}
                                                            </td>
                                                            <td>
                                                                <input type="text" name="mappings[{{ idx }}][tableRows][{{ loop.parent.loop.index0 }}][{{ colId }}][static]" value="{{ colStatic }}" class="fullwidth text" placeholder="Enter value…">
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    {% endfor %}
                                </div>
                                <button type="button" class="btn small add icon add-table-row-btn">Add row</button>
                            </div>
                        </td>
                    </tr>
                {% elseif field.type == 'matrix' %}
                    {# Decode existing matrix mappings from JSON #}
                    {% set matrixData = currentValue ? currentValue|json_decode : {} %}

                    <tr>
                        <td style="vertical-align: top;">
                            <strong>{{ field.name }}</strong>{% if field.required ?? false %}<span class="required"></span>{% endif %}<br>
                            <code style="font-size: 10px;">{{ field.handle }}</code>
                            <input type="hidden" name="mappings[{{ idx }}][craftFieldHandle]" value="{{ field.handle }}">
                        </td>
                        <td style="vertical-align: top;">
                            <span class="light">{{ field.fieldType }}</span>
                        </td>
                        <td colspan="2">
                            {% for entryType in field.entryTypes %}
                                {% set etRows = matrixData[entryType.handle] ?? [] %}
                                <div class="matrix-entry-type" style="border: 1px solid var(--gray-200); border-radius: 4px; padding: 12px; margin-bottom: 8px;" data-field-index="{{ idx }}" data-matrix-field="{{ field.handle }}" data-entry-type="{{ entryType.handle }}">
                                    <h4 style="margin: 0 0 8px 0;">{{ entryType.name }}</h4>
                                    <div class="matrix-entry-rows">
                                        {% for row in etRows %}
                                            {% set matrixRowIdx = loop.index0 %}
                                            <div class="matrix-entry-row" style="border: 1px solid var(--gray-200); border-radius: 4px; padding: 12px; margin-bottom: 8px; position: relative;">
                                                <a class="delete icon matrix-entry-row-delete" title="Remove" style="position: absolute; top: 6px; right: 6px;"></a>
                                                <table class="data fullwidth">
                                                    <thead>
                                                        <tr>
                                                            <th>Field</th>
                                                            <th>Akeneo Attribute</th>
                                                            <th>Static Value</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% for nestedField in entryType.fields %}
                                                            {% if nestedField.type == 'table' %}
                                                                {# Table field inside Matrix entry row #}
                                                                {% set nestedTableRows = row[nestedField.handle] ?? [] %}
                                                                <tr>
                                                                    <td style="vertical-align: top;" colspan="3">
                                                                        <strong>{{ nestedField.name }}</strong>
                                                                        <br>
                                                                        <code style="font-size: 10px;">{{ nestedField.handle }}</code>
                                                                        <div class="table-field-mapping" data-field-index="{{ idx }}" data-matrix-field="{{ field.handle }}" data-entry-type="{{ entryType.handle }}" data-matrix-row="{{ matrixRowIdx }}" data-table-field="{{ nestedField.handle }}">
                                                                            <div class="table-rows-body">
                                                                                {% for tableRow in nestedTableRows %}
                                                                                    {% set tableRowIdx = loop.index0 %}
                                                                                    <div class="table-mapping-row" style="border: 1px solid var(--gray-200); border-radius: 4px; padding: 12px; margin-bottom: 8px; position: relative;">
                                                                                        <a class="delete icon table-row-delete" title="Remove" style="position: absolute; top: 6px; right: 6px;"></a>
                                                                                        <table class="data fullwidth">
                                                                                            <thead>
                                                                                                <tr>
                                                                                                    <th>Column</th>
                                                                                                    <th>Akeneo Attribute</th>
                                                                                                    <th>Static Value</th>
                                                                                                </tr>
                                                                                            </thead>
                                                                                            <tbody>
                                                                                                {% for colId, col in nestedField.columns %}
                                                                                                    {% set colAkeneo = tableRow[colId].akeneo ?? '' %}
                                                                                                    {% set colStatic = tableRow[colId].static ?? '' %}
                                                                                                    {% set colValue = colAkeneo == '__static__' or (colStatic and not colAkeneo) ? '__static__' : (colAkeneo ?: '__none__') %}
                                                                                                    <tr>
                                                                                                        <td style="vertical-align: middle; white-space: nowrap;">
                                                                                                            <strong>{{ col.heading }}</strong><br><code style="font-size: 10px;">{{ col.handle }}</code>
                                                                                                        </td>
                                                                                                        <td>
                                                                                                            {{ forms.selectize({
                                                                                                                name: 'mappings[' ~ idx ~ '][matrix][' ~ entryType.handle ~ '][' ~ matrixRowIdx ~ '][' ~ nestedField.handle ~ '][tableRows][' ~ tableRowIdx ~ '][' ~ colId ~ '][akeneo]',
                                                                                                                value: colValue,
                                                                                                                options: akeneoSelectOptions,
                                                                                                            }) }}
                                                                                                        </td>
                                                                                                        <td>
                                                                                                            <input type="text" name="mappings[{{ idx }}][matrix][{{ entryType.handle }}][{{ matrixRowIdx }}][{{ nestedField.handle }}][tableRows][{{ tableRowIdx }}][{{ colId }}][static]" value="{{ colStatic }}" class="fullwidth text" placeholder="Enter value…">
                                                                                                        </td>
                                                                                                    </tr>
                                                                                                {% endfor %}
                                                                                            </tbody>
                                                                                        </table>
                                                                                    </div>
                                                                                {% endfor %}
                                                                            </div>
                                                                            <button type="button" class="btn small add icon add-table-row-btn">Add row</button>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            {% elseif nestedField.type == 'asset' %}
                                                                {# Asset field inside Matrix entry row #}
                                                                {% set nestedValue = row[nestedField.handle] ?? '' %}
                                                                {% set isNestedMultiAsset = nestedField.maxRelations is not defined or nestedField.maxRelations is null or nestedField.maxRelations != 1 %}
                                                                {% if isNestedMultiAsset %}
                                                                    {% set nestedAssetValues = nestedValue is iterable ? nestedValue : (nestedValue ? [nestedValue] : []) %}
                                                                {% endif %}
                                                                <tr>
                                                                    <td style="vertical-align: middle; white-space: nowrap;">
                                                                        <strong>{{ nestedField.name }}</strong>
                                                                        <br>
                                                                        <code style="font-size: 10px;">{{ nestedField.handle }}</code>
                                                                    </td>
                                                                    <td>
                                                                        {% if isNestedMultiAsset %}
                                                                            <select name="mappings[{{ idx }}][matrix][{{ entryType.handle }}][{{ matrixRowIdx }}][{{ nestedField.handle }}][akeneoMulti][]" multiple data-max-items="{{ nestedField.maxRelations ?? '' }}" style="display:none">
                                                                                {% for opt in akeneoAssetSelectOptions %}
                                                                                    {% if opt.value is defined and opt.value != '__none__' %}
                                                                                        <option value="{{ opt.value }}" {{ opt.value in nestedAssetValues ? 'selected' }}>{{ opt.label }}</option>
                                                                                    {% endif %}
                                                                                {% endfor %}
                                                                            </select>
                                                                        {% else %}
                                                                            {{ forms.selectize({
                                                                                name: 'mappings[' ~ idx ~ '][matrix][' ~ entryType.handle ~ '][' ~ matrixRowIdx ~ '][' ~ nestedField.handle ~ '][akeneo]',
                                                                                value: nestedValue ?: '__none__',
                                                                                options: akeneoAssetSelectOptions,
                                                                            }) }}
                                                                        {% endif %}
                                                                    </td>
                                                                    <td></td>
                                                                </tr>
                                                            {% elseif (nestedField.type == 'entries' or nestedField.type == 'categories') and nestedField.maxRelations != 1 %}
                                                                {# Multi Entries/Categories field inside Matrix entry row #}
                                                                {% set nestedValue = row[nestedField.handle] ?? '' %}
                                                                {% set nestedRelValues = nestedValue is iterable ? nestedValue : (nestedValue ? [nestedValue] : []) %}
                                                                <tr>
                                                                    <td style="vertical-align: middle; white-space: nowrap;">
                                                                        <strong>{{ nestedField.name }}</strong>
                                                                        <br>
                                                                        <code style="font-size: 10px;">{{ nestedField.handle }}</code>
                                                                    </td>
                                                                    <td>
                                                                        <select name="mappings[{{ idx }}][matrix][{{ entryType.handle }}][{{ matrixRowIdx }}][{{ nestedField.handle }}][akeneoMulti][]" multiple data-max-items="{{ nestedField.maxRelations ?? '' }}" style="display:none">
                                                                            {% for opt in akeneoSelectOptions %}
                                                                                {% if opt.value is defined and opt.value != '__none__' and opt.value != '__static__' and opt.optgroup is not defined %}
                                                                                    <option value="{{ opt.value }}" {{ opt.value in nestedRelValues ? 'selected' }}>{{ opt.label }}</option>
                                                                                {% endif %}
                                                                            {% endfor %}
                                                                        </select>
                                                                    </td>
                                                                    <td></td>
                                                                </tr>
                                                            {% else %}
                                                                {# Regular field inside Matrix entry row #}
                                                                {% if not nestedField.supported %}
                                                                    <tr>
                                                                        <td style="vertical-align: middle; white-space: nowrap;">
                                                                            <strong>{{ nestedField.name }}</strong>
                                                                            <br>
                                                                            <code style="font-size: 10px;">{{ nestedField.handle }}</code>
                                                                        </td>
                                                                        <td colspan="2">
                                                                            <span class="light">Not supported</span>
                                                                        </td>
                                                                    </tr>
                                                                {% else %}
                                                                    {% set nestedValue = row[nestedField.handle] ?? '' %}
                                                                    {% set nestedIsStatic = nestedValue starts with 'static:' %}
                                                                    {% set nestedStaticVal = nestedIsStatic ? nestedValue|slice(7) : '' %}
                                                                    {% set nestedSelectVal = nestedIsStatic ? '__static__' : (nestedValue ?: '__none__') %}
                                                                    <tr>
                                                                        <td style="vertical-align: middle; white-space: nowrap;">
                                                                            <strong>{{ nestedField.name }}</strong>
                                                                            <br>
                                                                            <code style="font-size: 10px;">{{ nestedField.handle }}</code>
                                                                        </td>
                                                                        <td>
                                                                            {{ forms.selectize({
                                                                                name: 'mappings[' ~ idx ~ '][matrix][' ~ entryType.handle ~ '][' ~ matrixRowIdx ~ '][' ~ nestedField.handle ~ '][akeneo]',
                                                                                value: nestedSelectVal,
                                                                                options: akeneoSelectOptions,
                                                                            }) }}
                                                                        </td>
                                                                        <td>
                                                                            <input type="text" name="mappings[{{ idx }}][matrix][{{ entryType.handle }}][{{ matrixRowIdx }}][{{ nestedField.handle }}][static]" value="{{ nestedStaticVal }}" class="fullwidth text matrix-static-value-input" placeholder="Enter value…" {% if not nestedIsStatic %}disabled{% endif %}>
                                                                        </td>
                                                                    </tr>
                                                                {% endif %}
                                                            {% endif %}
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    <button type="button" class="btn small add icon add-matrix-entry-btn">Add entry</button>
                                </div>
                            {% endfor %}
                        </td>
                    </tr>
                {% elseif field.type == 'asset' %}
                    {% set isMultiAsset = field.maxRelations is not defined or field.maxRelations is null or field.maxRelations != 1 %}
                    {% if isMultiAsset %}
                        {% set assetValues = currentValue ? currentValue|json_decode : [] %}
                        {% if assetValues is not iterable %}
                            {% set assetValues = currentValue ? [currentValue] : [] %}
                        {% endif %}
                    {% endif %}
                    <tr>
                        <td style="vertical-align: middle;">
                            <strong>{{ field.name }}</strong>{% if field.required ?? false %}<span class="required"></span>{% endif %}<br>
                            <code style="font-size: 10px;">{{ field.handle }}</code>
                            <input type="hidden" name="mappings[{{ idx }}][craftFieldHandle]" value="{{ field.handle }}">
                        </td>
                        <td style="vertical-align: middle;">
                            <span class="light">{{ field.fieldType }}</span>
                        </td>
                        <td>
                            {% if isMultiAsset %}
                                <select name="mappings[{{ idx }}][akeneoAssetMulti][]" id="akeneo-select-{{ idx }}" multiple data-max-items="{{ field.maxRelations ?? '' }}" style="display:none">
                                    {% for opt in akeneoAssetSelectOptions %}
                                        {% if opt.value is defined and opt.value != '__none__' %}
                                            <option value="{{ opt.value }}" {{ opt.value in assetValues ? 'selected' }}>{{ opt.label }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                            {% else %}
                                {{ forms.selectize({
                                    name: 'mappings[' ~ idx ~ '][akeneoAttribute]',
                                    id: 'akeneo-select-' ~ idx,
                                    value: currentValue ?: '__none__',
                                    options: akeneoAssetSelectOptions,
                                }) }}
                            {% endif %}
                        </td>
                        <td></td>
                    </tr>
                {% elseif (field.type == 'entries' or field.type == 'categories') and field.maxRelations != 1 %}
                    {% set relValues = currentValue ? currentValue|json_decode : [] %}
                    {% if relValues is not iterable %}
                        {% set relValues = currentValue ? [currentValue] : [] %}
                    {% endif %}
                    <tr>
                        <td style="vertical-align: middle;">
                            <strong>{{ field.name }}</strong>{% if field.required ?? false %}<span class="required"></span>{% endif %}<br>
                            <code style="font-size: 10px;">{{ field.handle }}</code>
                            <input type="hidden" name="mappings[{{ idx }}][craftFieldHandle]" value="{{ field.handle }}">
                        </td>
                        <td style="vertical-align: middle;">
                            <span class="light">{{ field.fieldType }}</span>
                        </td>
                        <td>
                            <select name="mappings[{{ idx }}][akeneoAssetMulti][]" id="akeneo-select-{{ idx }}" multiple data-max-items="{{ field.maxRelations ?? '' }}" style="display:none">
                                {% for opt in akeneoSelectOptions %}
                                    {% if opt.value is defined and opt.value != '__none__' and opt.value != '__static__' and opt.optgroup is not defined %}
                                        <option value="{{ opt.value }}" {{ opt.value in relValues ? 'selected' }}>{{ opt.label }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </td>
                        <td></td>
                    </tr>
                {% else %}
                    {% if not field.supported %}
                        <tr>
                            <td style="vertical-align: middle;">
                                <strong>{{ field.name }}</strong>{% if field.required ?? false %}<span class="required"></span>{% endif %}<br>
                                <code style="font-size: 10px;">{{ field.handle }}</code>
                            </td>
                            <td style="vertical-align: middle;">
                                <span class="light">{{ field.fieldType }}</span>
                            </td>
                            <td colspan="2">
                                <span class="light">Not supported</span>
                            </td>
                        </tr>
                    {% else %}
                        {# Check if current value is a static value #}
                        {% set isStatic = currentValue starts with 'static:' %}
                        {% set staticVal = isStatic ? currentValue|slice(7) : '' %}
                        {% set selectVal = isStatic ? '__static__' : (currentValue ?: '__none__') %}

                        <tr>
                            <td style="vertical-align: middle;">
                                <strong>{{ field.name }}</strong>{% if field.required ?? false %}<span class="required"></span>{% endif %}<br>
                                <code style="font-size: 10px;">{{ field.handle }}</code>
                                <input type="hidden" name="mappings[{{ idx }}][craftFieldHandle]" value="{{ field.handle }}">
                            </td>
                            <td style="vertical-align: middle;">
                                <span class="light">{{ field.fieldType }}</span>
                            </td>
                            <td>
                                {{ forms.selectize({
                                    name: 'mappings[' ~ idx ~ '][akeneoAttribute]',
                                    id: 'akeneo-select-' ~ idx,
                                    value: selectVal,
                                    options: akeneoSelectOptions,
                                }) }}
                            </td>
                            <td>
                                <input type="text" name="mappings[{{ idx }}][staticValue]" value="{{ staticVal }}" class="fullwidth text static-value-input" data-field-index="{{ idx }}" placeholder="Enter value…" {% if not isStatic %}disabled{% endif %}>
                            </td>
                        </tr>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </tbody>
    </table>

    {# Build options HTML for JS dynamic table rows #}
    {% set akeneoOptionsHtml %}
<option value="__none__">Don't import</option>
<option value="__static__">Static Value</option>
{% set lastJsType = null %}
{% for attribute in akeneoAttributes %}
{% if (attribute.type ?? '') != lastJsType %}
{% if lastJsType is not null %}</optgroup>{% endif %}
{% set lastJsType = attribute.type ?? '' %}
<optgroup label="{{ lastJsType ?: 'Other' }}">
{% endif %}
<option value="{{ attribute.code }}">{{ attribute.label }}</option>
{% endfor %}
{% if lastJsType is not null %}</optgroup>{% endif %}
    {% endset %}

    {# Build asset-only options HTML for JS dynamic matrix rows #}
    {% set akeneoAssetOptionsHtml %}
<option value="__none__">Don't import</option>
{% for attribute in akeneoAttributes %}
{% if (attribute.type ?? '') == 'pim_catalog_asset_collection' %}
<option value="{{ attribute.code }}">{{ attribute.label }}</option>
{% endif %}
{% endfor %}
    {% endset %}

    {# Build column config per table field for JS #}
    {% set tableFieldColumns = {} %}
    {% set matrixTableFieldColumns = {} %}
    {% set matrixFieldConfig = {} %}
    {% for field in craftFields %}
        {% if field.type == 'table' %}
            {% set tableFieldColumns = tableFieldColumns|merge({ (field.handle): field.columns }) %}
        {% elseif field.type == 'matrix' %}
            {% set entryTypesConfig = {} %}
            {% set matrixEntryTypes = {} %}
            {% for entryType in field.entryTypes %}
                {% set fieldsConfig = [] %}
                {% set entryTypeTableFields = {} %}
                {% for nestedField in entryType.fields %}
                    {% set fieldConfig = { handle: nestedField.handle, name: nestedField.name, type: nestedField.type, supported: nestedField.supported ?? true, maxRelations: nestedField.maxRelations ?? null } %}
                    {% if nestedField.type == 'table' %}
                        {% set fieldConfig = fieldConfig|merge({ columns: nestedField.columns }) %}
                        {% set entryTypeTableFields = entryTypeTableFields|merge({ (nestedField.handle): nestedField.columns }) %}
                    {% endif %}
                    {% set fieldsConfig = fieldsConfig|merge([fieldConfig]) %}
                {% endfor %}
                {% set entryTypesConfig = entryTypesConfig|merge({ (entryType.handle): { name: entryType.name, fields: fieldsConfig } }) %}
                {% if entryTypeTableFields|length %}
                    {% set matrixEntryTypes = matrixEntryTypes|merge({ (entryType.handle): entryTypeTableFields }) %}
                {% endif %}
            {% endfor %}
            {% set matrixFieldConfig = matrixFieldConfig|merge({ (field.handle): entryTypesConfig }) %}
            {% if matrixEntryTypes|length %}
                {% set matrixTableFieldColumns = matrixTableFieldColumns|merge({ (field.handle): matrixEntryTypes }) %}
            {% endif %}
        {% endif %}
    {% endfor %}

    {% js %}
    (function($) {
        var akeneoOptionsHtml = {{ akeneoOptionsHtml|json_encode|raw }};
        var akeneoAssetOptionsHtml = {{ akeneoAssetOptionsHtml|json_encode|raw }};
        var tableFieldColumns = {{ tableFieldColumns|json_encode|raw }};
        var matrixTableFieldColumns = {{ matrixTableFieldColumns|json_encode|raw }};
        var matrixFieldConfig = {{ matrixFieldConfig|json_encode|raw }};

        function initSelectize(selectEl) {
            var $sel = $(selectEl);
            if ($sel[0].selectize) return;
            var opts = {
                plugins: ['auto_position'],
            };
            var maxItems = selectEl.getAttribute('data-max-items');
            if (maxItems) {
                opts.maxItems = parseInt(maxItems, 10);
            }
            $sel.selectize(opts);
        }

        // Toggle static value input for regular fields
        $(document).on('change', 'select[name*="[akeneoAttribute]"]', function() {
            var tr = $(this).closest('tr')[0];
            if (!tr) return;
            var staticInput = tr.querySelector('.static-value-input');
            if (!staticInput) return;

            if (this.value === '__static__') {
                staticInput.disabled = false;
                staticInput.focus();
            } else {
                staticInput.disabled = true;
                staticInput.value = '';
            }
        });

        // Toggle static value input for matrix regular fields
        $(document).on('change', 'select[name*="[matrix]"][name*="[akeneo]"]', function() {
            // Skip table column selects (they contain [tableRows])
            if (this.name.indexOf('[tableRows]') !== -1) return;
            var tr = $(this).closest('tr')[0];
            if (!tr) return;
            var staticInput = tr.querySelector('.matrix-static-value-input');
            if (!staticInput) return;

            if (this.value === '__static__') {
                staticInput.disabled = false;
                staticInput.focus();
            } else {
                staticInput.disabled = true;
                staticInput.value = '';
            }
        });

        // Add table row (top-level or inside matrix entry row)
        document.addEventListener('click', function(e) {
            var addBtn = e.target.closest('.add-table-row-btn');
            if (!addBtn) return;

            var wrapper = addBtn.closest('.table-field-mapping');
            var fieldIndex = wrapper.getAttribute('data-field-index');
            var body = wrapper.querySelector('.table-rows-body');
            var rowIndex = body.querySelectorAll('.table-mapping-row').length;

            var matrixField = wrapper.getAttribute('data-matrix-field');
            var entryTypeHandle = wrapper.getAttribute('data-entry-type');
            var matrixRowIndex = wrapper.getAttribute('data-matrix-row');
            var tableFieldHandle = wrapper.getAttribute('data-table-field');
            var columns;
            var namePrefix;

            if (matrixField && entryTypeHandle && tableFieldHandle && matrixRowIndex !== null) {
                // Table field inside Matrix entry row
                columns = matrixTableFieldColumns[matrixField] && matrixTableFieldColumns[matrixField][entryTypeHandle]
                    ? matrixTableFieldColumns[matrixField][entryTypeHandle][tableFieldHandle]
                    : null;
                namePrefix = 'mappings[' + fieldIndex + '][matrix][' + entryTypeHandle + '][' + matrixRowIndex + '][' + tableFieldHandle + '][tableRows][' + rowIndex + ']';
            } else {
                // Top-level table field
                var hiddenInput = wrapper.closest('tr').querySelector('input[type="hidden"]');
                var fieldHandle = hiddenInput.value;
                columns = tableFieldColumns[fieldHandle];
                namePrefix = 'mappings[' + fieldIndex + '][tableRows][' + rowIndex + ']';
            }

            if (!columns) return;

            var div = document.createElement('div');
            div.className = 'table-mapping-row';
            div.style.cssText = 'border: 1px solid var(--gray-200); border-radius: 4px; padding: 12px; margin-bottom: 8px; position: relative;';

            var html = '<a class="delete icon table-row-delete" title="Remove" style="position: absolute; top: 6px; right: 6px;"></a>';
            html += '<table class="data fullwidth"><thead><tr><th>Column</th><th>Akeneo Attribute</th><th>Static Value</th></tr></thead><tbody>';

            for (var colId in columns) {
                html += '<tr>';
                html += '<td style="vertical-align: middle; white-space: nowrap;"><strong>' + columns[colId].heading + '</strong><br><code style="font-size: 10px;">' + columns[colId].handle + '</code></td>';
                html += '<td><select name="' + namePrefix + '[' + colId + '][akeneo]" style="display:none">' + akeneoOptionsHtml + '</select></td>';
                html += '<td><input type="text" name="' + namePrefix + '[' + colId + '][static]" value="" class="fullwidth text" placeholder="Enter value…"></td>';
                html += '</tr>';
            }

            html += '</tbody></table>';

            div.innerHTML = html;
            body.appendChild(div);

            // Init selectize on new selects
            div.querySelectorAll('select').forEach(function(sel) {
                initSelectize(sel);
            });
        });

        // Add matrix entry row
        document.addEventListener('click', function(e) {
            var addBtn = e.target.closest('.add-matrix-entry-btn');
            if (!addBtn) return;

            var wrapper = addBtn.closest('.matrix-entry-type');
            var fieldIndex = wrapper.getAttribute('data-field-index');
            var matrixFieldHandle = wrapper.getAttribute('data-matrix-field');
            var entryTypeHandle = wrapper.getAttribute('data-entry-type');
            var body = wrapper.querySelector('.matrix-entry-rows');
            var rowIndex = body.querySelectorAll('.matrix-entry-row').length;

            var entryTypeConfig = matrixFieldConfig[matrixFieldHandle] && matrixFieldConfig[matrixFieldHandle][entryTypeHandle];
            if (!entryTypeConfig) return;

            var div = document.createElement('div');
            div.className = 'matrix-entry-row';
            div.style.cssText = 'border: 1px solid var(--gray-200); border-radius: 4px; padding: 12px; margin-bottom: 8px; position: relative;';

            var html = '<a class="delete icon matrix-entry-row-delete" title="Remove" style="position: absolute; top: 6px; right: 6px;"></a>';
            html += '<table class="data fullwidth"><thead><tr><th>Field</th><th>Akeneo Attribute</th><th>Static Value</th></tr></thead><tbody>';

            entryTypeConfig.fields.forEach(function(field) {
                if (field.type === 'table') {
                    html += '<tr><td style="vertical-align: top;" colspan="3">';
                    html += '<strong>' + field.name + '</strong><br><code style="font-size: 10px;">' + field.handle + '</code>';
                    html += '<div class="table-field-mapping" data-field-index="' + fieldIndex + '" data-matrix-field="' + matrixFieldHandle + '" data-entry-type="' + entryTypeHandle + '" data-matrix-row="' + rowIndex + '" data-table-field="' + field.handle + '">';
                    html += '<div class="table-rows-body"></div>';
                    html += '<button type="button" class="btn small add icon add-table-row-btn">Add row</button>';
                    html += '</div>';
                    html += '</td></tr>';
                } else if (field.type === 'asset') {
                    var isMulti = !field.maxRelations || field.maxRelations !== 1;
                    html += '<tr>';
                    html += '<td style="vertical-align: middle; white-space: nowrap;"><strong>' + field.name + '</strong><br><code style="font-size: 10px;">' + field.handle + '</code></td>';
                    if (isMulti) {
                        html += '<td><select name="mappings[' + fieldIndex + '][matrix][' + entryTypeHandle + '][' + rowIndex + '][' + field.handle + '][akeneoMulti][]" multiple data-max-items="' + (field.maxRelations || '') + '" style="display:none">' + akeneoAssetOptionsHtml + '</select></td>';
                    } else {
                        html += '<td><select name="mappings[' + fieldIndex + '][matrix][' + entryTypeHandle + '][' + rowIndex + '][' + field.handle + '][akeneo]" style="display:none">' + akeneoAssetOptionsHtml + '</select></td>';
                    }
                    html += '<td></td>';
                    html += '</tr>';
                } else if ((field.type === 'entries' || field.type === 'categories') && field.maxRelations !== 1) {
                    html += '<tr>';
                    html += '<td style="vertical-align: middle; white-space: nowrap;"><strong>' + field.name + '</strong><br><code style="font-size: 10px;">' + field.handle + '</code></td>';
                    html += '<td><select name="mappings[' + fieldIndex + '][matrix][' + entryTypeHandle + '][' + rowIndex + '][' + field.handle + '][akeneoMulti][]" multiple data-max-items="' + (field.maxRelations || '') + '" style="display:none">' + akeneoOptionsHtml + '</select></td>';
                    html += '<td></td>';
                    html += '</tr>';
                } else if (!field.supported) {
                    html += '<tr>';
                    html += '<td style="vertical-align: middle; white-space: nowrap;"><strong>' + field.name + '</strong><br><code style="font-size: 10px;">' + field.handle + '</code></td>';
                    html += '<td colspan="2"><span class="light">Not supported</span></td>';
                    html += '</tr>';
                } else {
                    html += '<tr>';
                    html += '<td style="vertical-align: middle; white-space: nowrap;"><strong>' + field.name + '</strong><br><code style="font-size: 10px;">' + field.handle + '</code></td>';
                    html += '<td><select name="mappings[' + fieldIndex + '][matrix][' + entryTypeHandle + '][' + rowIndex + '][' + field.handle + '][akeneo]" style="display:none">' + akeneoOptionsHtml + '</select></td>';
                    html += '<td><input type="text" name="mappings[' + fieldIndex + '][matrix][' + entryTypeHandle + '][' + rowIndex + '][' + field.handle + '][static]" value="" class="fullwidth text matrix-static-value-input" placeholder="Enter value…" disabled></td>';
                    html += '</tr>';
                }
            });

            html += '</tbody></table>';

            div.innerHTML = html;
            body.appendChild(div);

            // Init selectize on new selects
            div.querySelectorAll('select').forEach(function(sel) {
                initSelectize(sel);
            });
        });

        // Remove table row
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('table-row-delete')) {
                e.target.closest('.table-mapping-row').remove();
            }
        });

        // Remove matrix entry row
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('matrix-entry-row-delete')) {
                e.target.closest('.matrix-entry-row').remove();
            }
        });

        // Init selectize on multi-select asset fields on page load
        document.querySelectorAll('select[multiple]').forEach(function(sel) {
            initSelectize(sel);
        });
    })(jQuery);
    {% endjs %}

{% endblock %}
