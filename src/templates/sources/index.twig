{% extends '_layouts/cp' %}

{% set title = 'Sources' %}
{% set selectedSubnavItem = 'sources' %}

{% block actionButton %}
    <div class="btngroup submit">
        <a href="{{ url('akeneo/sources/new') }}" class="btn submit">{{ 'New Source'|t('akeneo') }}</a>
        <button type="button" class="btn submit menubtn" title="{{ 'Actions'|t('akeneo') }}"></button>
        <div class="menu">
            <ul>
                <li><a id="akeneo-import-source">{{ 'Import'|t('akeneo') }}</a></li>
            </ul>
        </div>
    </div>
{% endblock %}

{% block content %}

    <form id="akeneo-import-form" method="post" accept-charset="UTF-8" enctype="multipart/form-data" style="display:none;">
        {{ csrfInput() }}
        <input type="hidden" name="action" value="akeneo/sources/import">
        <input type="file" name="file" accept=".json,application/json" id="akeneo-import-file">
    </form>

    {% if sources|length %}
        <div id="sources">
            <table id="sources-table" class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'ID'|t('akeneo') }}</th>
                        <th>{{ 'Name'|t('akeneo') }}</th>
                        <th>{{ 'Content Type'|t('akeneo') }}</th>
                        <th>{{ 'Entry Type'|t('akeneo') }}</th>
                        <th>{{ 'Est. Products'|t('akeneo') }}</th>
                        <th>{{ 'Last Synced'|t('akeneo') }}</th>
                        <th>{{ 'Action'|t('akeneo') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for source in sources %}
                        <tr data-id="{{ source.id }}" data-name="{{ source.title }}">
                            <td>{{ source.id }}</td>
                            <td><a href="{{ url(source.url) }}">{{ source.title }}</a></td>
                            <td>{{ source.contentType }}</td>
                            <td>{{ source.type }}</td>
                            <td>{{ source.estimatedProducts is not null ? source.estimatedProducts|number : '—' }}</td>
                            <td>
                                {{ source.lastSyncedAt ? date(source.lastSyncedAt)|timestamp : 'Never' }}
                                {% if source.hasFailures %}
                                    <a href="{{ url('akeneo/sources/' ~ source.id ~ '/log', { status: 'fail' }) }}" title="{{ 'This source has logged sync failures'|t('akeneo') }}" style="margin-left:6px;color:var(--error-color);"><span class="icon" style="display:inline-flex;width:14px;height:14px;vertical-align:-2px;">{{ iconSvg('triangle-exclamation') }}</span></a>
                                {% endif %}
                            </td>
                            <td class="thin">
                                {% include 'akeneo/sources/_sync-menu' %}
                            </td>
                            <td class="thin">
                                <a role="button" title="{{ 'Duplicate'|t('akeneo') }}" data-akeneo-duplicate="{{ source.id }}" style="margin-right:10px;cursor:pointer;color:var(--medium-text-color);"><span class="icon" style="display:inline-flex;width:14px;height:14px;vertical-align:-2px;">{{ iconSvg('clone') }}</span></a>
                                <a class="delete icon" title="{{ 'Delete'|t('app') }}"></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>{{ 'No sources exist yet.'|t('akeneo') }}</p>
    {% endif %}

{% endblock %}

{% js %}
    new Craft.AdminTable({
        tableSelector: '#sources-table',
        deleteAction: 'akeneo/sources/delete',
        confirmDeleteMessage: '{{ 'Are you sure you want to delete this source?'|t('akeneo') }}',
    });

    var importBtn = document.getElementById('akeneo-import-source');
    var importFile = document.getElementById('akeneo-import-file');
    var importForm = document.getElementById('akeneo-import-form');

    if (importBtn && importFile && importForm) {
        importBtn.addEventListener('click', function(e) {
            e.preventDefault();
            importFile.click();
        });
        importFile.addEventListener('change', function() {
            if (importFile.files.length) {
                importForm.submit();
            }
        });
    }

    document.querySelectorAll('[data-akeneo-duplicate]').forEach(function(el) {
        el.addEventListener('click', function(e) {
            e.preventDefault();

            var sourceId = this.getAttribute('data-akeneo-duplicate');

            if (!confirm('{{ 'Are you sure you want to duplicate this source?'|t('akeneo') }}')) {
                return;
            }

            Craft.postActionRequest('akeneo/sources/duplicate', { sourceId: sourceId }, function(response) {
                if (response && response.success) {
                    window.location.href = Craft.getCpUrl('akeneo/sources');
                } else {
                    Craft.cp.displayError('{{ 'Could not duplicate source.'|t('akeneo') }}');
                }
            });
        });
    });

    document.querySelectorAll('[data-sync-type]').forEach(function(el) {
        el.addEventListener('click', function(e) {
            e.preventDefault();

            var type = this.dataset.syncType;
            var sourceId = this.dataset.sourceId;
            var label = this.textContent;

            Craft.postActionRequest('akeneo/sync/run', { type: type, sourceId: sourceId }, function(response) {
                if (response.success) {
                    Craft.cp.displayNotice(label + ' jobs added to the queue.');
                } else {
                    Craft.cp.displayError(label + ' failed.');
                }
            });
        });
    });
{% endjs %}
