{% extends '_layouts/cp' %}

{% import '_includes/forms.twig' as forms %}

{% set fullPageForm = true %}

{% set title = title %}
{% set selectedSubnavItem = 'sources' %}

{% set crumbs = [
    { label: 'Akeneo', url: url('akeneo') },
    { label: 'Sources', url: url('akeneo/sources') },
] %}

{% if source.id %}
    {% set tabs = {
        settings: { label: 'Settings', url: url('akeneo/sources/' ~ source.id) },
        fieldMapping: { label: 'Field Mapping', url: url('akeneo/sources/' ~ source.id ~ '/field-mapping') },
        consoleCommands: { label: 'Console Commands', url: url('akeneo/sources/' ~ source.id ~ '/console-commands') },
        log: { label: 'Log'|t('akeneo') ~ ((sourceHasFailures ?? false) ? ' ⚠'), url: url('akeneo/sources/' ~ source.id ~ '/log') },
    } %}
    {% set selectedTab = 'settings' %}
{% endif %}

{% block actionButton %}
    {% include 'akeneo/sources/_sync-button' %}
    {% include 'akeneo/sources/_save-button' with {
        continueEditingUrl: source.id ? 'akeneo/sources/' ~ source.id : 'akeneo/sources/{id}',
    } %}
{% endblock %}

{% block content %}

    <input type="hidden" name="action" value="akeneo/sources/save">
    {{ redirectInput(source.id ? 'akeneo/sources/' ~ source.id : 'akeneo/sources') }}

    {% if source.id %}
        <input type="hidden" name="sourceId" value="{{ source.id }}">
    {% endif %}

    {{ forms.textField({
        first: true,
        label: 'Name'|t('akeneo'),
        instructions: 'What this source will be called in the CP.'|t('akeneo'),
        id: 'name',
        name: 'name',
        value: source.name,
        errors: source.getErrors('name'),
        required: true,
        autofocus: true,
    }) }}

    {% set currentTypeValue = source.type and source.typeId ? source.type ~ ':' ~ source.typeId : '' %}

    {{ forms.selectField({
        label: 'Type'|t('akeneo'),
        instructions: 'The section or product type to associate with this source.'|t('akeneo'),
        id: 'type',
        name: 'type',
        value: currentTypeValue,
        options: [{ label: 'Select…', value: '' }]|merge(typeOptions),
        errors: source.getErrors('type'),
        required: true,
    }) }}

    {{ forms.selectField({
        label: 'Orphaned Entry Action'|t('akeneo'),
        instructions: 'What should happen to Craft entries that no longer exist in Akeneo after a sync completes.'|t('akeneo'),
        id: 'orphanedEntryAction',
        name: 'orphanedEntryAction',
        value: source.orphanedEntryAction ?? 'doNothing',
        options: [
            { label: 'Do Nothing', value: 'doNothing' },
            { label: 'Disable', value: 'disable' },
            { label: 'Delete', value: 'delete' },
        ],
        errors: source.getErrors('orphanedEntryAction'),
    }) }}

    {% if source.id and identifierOptions is defined and identifierOptions|length %}
        {{ forms.selectField({
            label: 'Entry Identifier'|t('akeneo'),
            instructions: 'The Craft field used to match existing entries during sync. This field should contain a unique value per entry (e.g. SKU or product code).'|t('akeneo'),
            id: 'entryIdentifier',
            name: 'entryIdentifier',
            value: source.entryIdentifier ?? '',
            options: [{ label: 'Select…', value: '' }]|merge(identifierOptions),
            errors: source.getErrors('entryIdentifier'),
            required: true,
        }) }}
    {% endif %}

    {% if localeOptions is defined and localeOptions|length %}
        {{ forms.selectField({
            label: 'Akeneo Locale'|t('akeneo'),
            instructions: 'The Akeneo locale to use when pulling attribute values for this source (e.g. en_GB, en_US).'|t('akeneo'),
            id: 'akeneoLocale',
            name: 'akeneoLocale',
            value: source.akeneoLocale ?? '',
            options: [{ label: 'Select…', value: '' }]|merge(localeOptions),
            errors: source.getErrors('akeneoLocale'),
            required: true,
        }) }}
    {% elseif localeSettingsMissing is defined and localeSettingsMissing %}
        <div class="field">
            <div class="heading">
                <label>{{ 'Akeneo Locale'|t('akeneo') }}</label>
            </div>
            <p class="warning">{{ 'Akeneo API settings are not configured. Please {link} to connect to Akeneo before creating a source.'|t('akeneo', { link: '<a href="' ~ settingsUrl ~ '">' ~ 'add your API settings'|t('akeneo') ~ '</a>' })|raw }}</p>
        </div>
    {% elseif localeError is defined and localeError %}
        <div class="field">
            <div class="heading">
                <label>{{ 'Akeneo Locale'|t('akeneo') }}</label>
            </div>
            <p class="error">{{ 'Could not load Akeneo locales: '|t('akeneo') ~ localeError }}</p>
        </div>
    {% endif %}

    {% if siteOptions is defined and siteOptions|length > 1 %}
        {{ forms.selectField({
            label: 'Site'|t('akeneo'),
            instructions: 'The Craft site to import entries into. If not set, entries will be saved to the primary site.'|t('akeneo'),
            id: 'siteId',
            name: 'siteId',
            value: source.siteId ?? '',
            options: [{ label: 'Primary Site', value: '' }]|merge(siteOptions),
            errors: source.getErrors('siteId'),
        }) }}
    {% endif %}

    <hr>

    {% set existingFilters = source.filters ? source.filters|json_decode : [] %}

    <div class="field">
        <div class="heading">
            <label>{{ 'Product Filters'|t('akeneo') }}</label>
            <div class="instructions"><p>{{ 'Filter which Akeneo products are imported during sync. Leave empty to import all products.'|t('akeneo') }}</p></div>
        </div>
        <div class="input">
            <div id="filters-container">
                {% for filter in existingFilters %}
                    <div class="filter-row" style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px;">
                        <input type="text" name="filters[{{ loop.index0 }}][attribute]" value="{{ filter.attribute }}" class="text" placeholder="Attribute code" style="flex: 0 0 33%;">
                        <div style="flex: 0 0 180px;">
                            <select name="filters[{{ loop.index0 }}][operator]" class="text" style="width: 100%;">
                                {% for op in ['=', '!=', '<', '>', '<=', '>=', 'IN', 'NOT IN', 'CONTAINS', 'DOES NOT CONTAIN', 'STARTS WITH', 'EMPTY', 'NOT EMPTY', 'BETWEEN', 'NOT BETWEEN'] %}
                                    <option value="{{ op }}" {{ filter.operator == op ? 'selected' }}>{{ op }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <input type="text" name="filters[{{ loop.index0 }}][value]" value="{{ filter.value }}" class="text" placeholder="Value" style="flex: 1;">
                        <a class="delete icon filter-row-delete" title="Remove" style="margin-left: auto;"></a>
                    </div>
                {% endfor %}
            </div>
            <button type="button" class="btn small add icon" id="add-filter-btn">{{ 'Add filter'|t('akeneo') }}</button>
        </div>
    </div>

    {% js %}
    (function() {
        var container = document.getElementById('filters-container');
        var addBtn = document.getElementById('add-filter-btn');

        var operators = {{ ['=', '!=', '<', '>', '<=', '>=', 'IN', 'NOT IN', 'CONTAINS', 'DOES NOT CONTAIN', 'STARTS WITH', 'EMPTY', 'NOT EMPTY', 'BETWEEN', 'NOT BETWEEN']|json_encode|raw }};

        // Operators that don't take a value.
        var noValueOperators = ['EMPTY', 'NOT EMPTY'];

        function updateValueVisibility(row) {
            var operatorSelect = row.querySelector('select[name*="[operator]"]');
            var valueInput = row.querySelector('input[name*="[value]"]');
            if (!operatorSelect || !valueInput) return;

            var hide = noValueOperators.indexOf(operatorSelect.value) !== -1;
            valueInput.style.display = hide ? 'none' : '';
            if (hide) {
                valueInput.value = '';
            }
        }

        container.querySelectorAll('.filter-row').forEach(updateValueVisibility);

        container.addEventListener('change', function(e) {
            if (e.target.matches('select[name*="[operator]"]')) {
                updateValueVisibility(e.target.closest('.filter-row'));
            }
        });

        addBtn.addEventListener('click', function() {
            var idx = container.querySelectorAll('.filter-row').length;
            var div = document.createElement('div');
            div.className = 'filter-row';
            div.style.cssText = 'display: flex; gap: 8px; align-items: center; margin-bottom: 8px;';

            var optionsHtml = '';
            operators.forEach(function(op) {
                optionsHtml += '<option value="' + op + '">' + op + '</option>';
            });

            div.innerHTML = '<input type="text" name="filters[' + idx + '][attribute]" value="" class="text" placeholder="Attribute code" style="flex: 0 0 33%;">'
                + '<div style="flex: 0 0 180px;"><select name="filters[' + idx + '][operator]" class="text" style="width: 100%;">' + optionsHtml + '</select></div>'
                + '<input type="text" name="filters[' + idx + '][value]" value="" class="text" placeholder="Value" style="flex: 1;">'
                + '<a class="delete icon filter-row-delete" title="Remove" style="margin-left: auto;"></a>';

            container.appendChild(div);
            updateValueVisibility(div);
        });

        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('filter-row-delete')) {
                e.target.closest('.filter-row').remove();
            }
        });
    })();
    {% endjs %}

{% endblock %}
