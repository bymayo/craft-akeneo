{% set sources = sources|default([]) %}
{% set failures = failures|default({}) %}
{% set settingsMissing = settingsMissing|default(false) %}
{% set settingsUrl = settingsUrl|default(cpUrl('akeneo/settings')) %}

{% if settingsMissing %}
    <p class="light">{{ 'Akeneo API settings are not configured.'|t('akeneo') }} <a href="{{ settingsUrl }}">{{ 'Add your API settings'|t('akeneo') }}</a></p>
{% elseif not sources|length %}
    <p class="light">{{ 'No sources configured.'|t('akeneo') }} <a href="{{ url('akeneo/sources/new') }}">{{ 'Create one'|t('akeneo') }}</a></p>
{% else %}
    {% for source in sources %}
        <div class="akeneo-widget-source" style="{% if not loop.first %}margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--gray-200);{% endif %}">
            <strong style="display: block; margin-bottom: 8px;">{{ source.name }}</strong>
            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                <button type="button" class="btn small akeneo-sync-btn" data-source-id="{{ source.id }}" data-type="all"><span class="icon" style="display:inline-flex;width:12px;height:12px;vertical-align:-2px;margin-right:4px;">{{ iconSvg('arrows-rotate') }}</span>{{ 'Sync All'|t('akeneo') }}</button>
                <button type="button" class="btn small akeneo-sync-btn" data-source-id="{{ source.id }}" data-type="data"><span class="icon" style="display:inline-flex;width:12px;height:12px;vertical-align:-2px;margin-right:4px;">{{ iconSvg('database') }}</span>{{ 'Data Only'|t('akeneo') }}</button>
                <button type="button" class="btn small akeneo-sync-btn" data-source-id="{{ source.id }}" data-type="images"><span class="icon" style="display:inline-flex;width:12px;height:12px;vertical-align:-2px;margin-right:4px;">{{ iconSvg('image') }}</span>{{ 'Images Only'|t('akeneo') }}</button>
            </div>
            {% if source.lastSyncedAt %}
                <span class="light" style="font-size: 11px; display: block; margin-top: 8px;">
                    {{ 'Last Synced:'|t('akeneo') }} {{ date(source.lastSyncedAt)|timestamp }}
                    {% if failures[source.id] ?? false %}
                        <a href="{{ url('akeneo/sources/' ~ source.id ~ '/log', { status: 'fail' }) }}" title="{{ 'This source has logged sync failures'|t('akeneo') }}" style="margin-left:4px;color:var(--error-color);"><span class="icon" style="display:inline-flex;width:12px;height:12px;vertical-align:-2px;">{{ iconSvg('triangle-exclamation') }}</span></a>
                    {% endif %}
                </span>
            {% else %}
                <span class="light" style="font-size: 11px; display: block; margin-top: 8px;">{{ 'Last Synced:'|t('akeneo') }} {{ 'Never'|t('akeneo') }}</span>
            {% endif %}
        </div>
    {% endfor %}
{% endif %}

<script type="text/javascript">
(function() {
    document.querySelectorAll('.akeneo-sync-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var sourceId = this.getAttribute('data-source-id');
            var type = this.getAttribute('data-type');
            var button = this;

            button.classList.add('loading');
            button.disabled = true;

            var body = new FormData();
            body.append(Craft.csrfTokenName, Craft.csrfTokenValue);
            body.append('sourceId', sourceId);
            body.append('type', type);

            fetch(Craft.actionUrl + '/akeneo/sync/run', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: body
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                button.classList.remove('loading');
                button.disabled = false;

                if (data && data.success) {
                    Craft.cp.displayNotice('Sync job queued.');
                } else {
                    Craft.cp.displayError('Sync failed.');
                }
            })
            .catch(function() {
                button.classList.remove('loading');
                button.disabled = false;
                Craft.cp.displayError('Sync failed.');
            });
        });
    });
})();
</script>
